+package chi
+
+import (
+	"context"
+	"net/http"
+	"time"
+)
+
+// MetricsCollector is an interface for collecting route hit metrics.
+type MetricsCollector interface {
+	RecordHit(ctx context.Context, req *http.Request, duration time.Duration)
+}
+
+// RouteMetric contains timing and route information for a single route hit.
+type RouteMetric struct {
+	Pattern  string            // matched route pattern, e.g. "/users/{id}"
+	Method   string
+	Path     string
+	Duration time.Duration
+	Params   map[string]string // URL parameters keyed by name, e.g. {"id": "123"}
+}
+
+// SimpleMetricsCollector provides a basic metric collector using a callback function.
+type SimpleMetricsCollector struct {
+	OnHit func(RouteMetric)
+}
+
+var _ MetricsCollector = SimpleMetricsCollector{}
+var _ MetricsCollector = (*SimpleMetricsCollector)(nil)
+
+// RecordHit records a route hit by extracting route details and calling OnHit callback.
+func (c SimpleMetricsCollector) RecordHit(ctx context.Context, req *http.Request, duration time.Duration) {
+	if c.OnHit == nil {
+		return
+	}
+
+	var pattern string
+	var method string
+	var path string
+	params := make(map[string]string)
+
+	if req != nil {
+		method = req.Method
+		if req.URL != nil {
+			path = req.URL.Path
+		}
+	}
+
+	if ctx == nil && req != nil {
+		ctx = req.Context()
+	}
+
+	if ctx != nil {
+		if rctx := RouteContext(ctx); rctx != nil {
+			pattern = rctx.RoutePattern()
+			if pattern == "" && rctx.routePattern != "" {
+				pattern = rctx.routePattern
+			}
+			if method == "" {
+				method = rctx.RouteMethod
+			}
+			for i, key := range rctx.URLParams.Keys {
+				if i < len(rctx.URLParams.Values) {
+					if key == "*" && rctx.URLParams.Values[i] == "" {
+						continue
+					}
+					params[key] = rctx.URLParams.Values[i]
+				}
+			}
+		}
+	}
+
+	c.OnHit(RouteMetric{
+		Pattern:  pattern,
+		Method:   method,
+		Path:     path,
+		Duration: duration,
+		Params:   params,
+	})
+}
diff --git a/metrics_test.go b/metrics_test.go
