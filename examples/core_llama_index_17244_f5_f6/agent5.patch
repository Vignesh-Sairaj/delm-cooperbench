diff --git a/llama-index-core/tests/base/llms/test_types.py b/llama-index-core/tests/base/llms/test_types.py
index 1a7b7479d..c47dc5d3f 100644
--- a/llama-index-core/tests/base/llms/test_types.py
+++ b/llama-index-core/tests/base/llms/test_types.py
@@ -165,3 +165,55 @@ def test_image_block_store_as_anyurl():
     url_str = "http://example.com"
     b = ImageBlock(url=url_str)
     assert b.url == AnyUrl(url=url_str)
+
+
+def test_image_block_get_image_mimetype_from_image(png_1px: bytes):
+    b = ImageBlock(image=png_1px)
+    assert b.image_mimetype is None
+    mimetype = b.get_image_mimetype()
+    assert mimetype == "image/png"
+    assert b.image_mimetype == "image/png"
+    assert b.get_image_mimetype() == "image/png"
+
+
+def test_image_block_get_image_mimetype_from_path(tmp_path: Path, png_1px: bytes):
+    png_path = tmp_path / "test.png"
+    png_path.write_bytes(png_1px)
+
+    b = ImageBlock(path=png_path)
+    assert b.image_mimetype is None
+    mimetype = b.get_image_mimetype()
+    assert mimetype == "image/png"
+    assert b.image_mimetype == "image/png"
+
+
+def test_image_block_get_image_mimetype_from_url(png_1px: bytes):
+    with mock.patch("llama_index.core.base.llms.types.requests") as mocked_req:
+        url_str = "http://example.com/test.png"
+        mocked_req.get.return_value = mock.MagicMock(content=png_1px)
+        b = ImageBlock(url=AnyUrl(url=url_str))
+        assert b.image_mimetype is None
+        mimetype = b.get_image_mimetype()
+        assert mimetype == "image/png"
+        assert b.image_mimetype == "image/png"
+
+
+def test_image_block_get_image_mimetype_predefined(png_1px: bytes):
+    b = ImageBlock(image=png_1px, image_mimetype="image/custom")
+    assert b.get_image_mimetype() == "image/custom"
+    assert b.image_mimetype == "image/custom"
+
+
+def test_image_block_get_image_mimetype_caching(png_1px: bytes):
+    b = ImageBlock(image=png_1px)
+    assert b.get_image_mimetype() == "image/png"
+
+    with mock.patch.object(ImageBlock, "resolve_image") as mock_resolve:
+        assert b.get_image_mimetype() == "image/png"
+        mock_resolve.assert_not_called()
+
+
+def test_image_block_get_image_mimetype_unknown():
+    b = ImageBlock(image=b"random invalid bytes not an image")
+    assert b.get_image_mimetype() is None
+    assert b.image_mimetype is None
