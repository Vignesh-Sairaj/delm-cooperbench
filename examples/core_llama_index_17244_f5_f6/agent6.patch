+def test_image_block_encoding(png_1px: bytes, png_1px_b64: bytes):
+    # Default encoding is base64
+    b = ImageBlock(image=png_1px)
+    assert b.encoding == "base64"
+    assert b.image == png_1px_b64
+
+    # Explicit base64 encoding
+    b = ImageBlock(image=png_1px, encoding="base64")
+    assert b.encoding == "base64"
+    assert b.image == png_1px_b64
+
+    # Raw encoding
+    b = ImageBlock(image=png_1px, encoding="raw")
+    assert b.encoding == "raw"
+    assert b.image == png_1px
+
+    # Resolve image with raw encoding
+    img = b.resolve_image()
+    assert isinstance(img, BytesIO)
+    assert img.read() == png_1px
+
+    img = b.resolve_image(as_base64=True)
+    assert isinstance(img, BytesIO)
+    assert img.read() == png_1px_b64
+
+
+def test_image_block_encoding_invalid(png_1px: bytes):
+    with pytest.raises(ValidationError):
+        ImageBlock(image=png_1px, encoding="invalid")
+
