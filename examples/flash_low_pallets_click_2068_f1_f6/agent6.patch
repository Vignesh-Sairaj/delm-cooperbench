+
+            def Popen_priority_wrapper(*args: t.Any, **kwargs: t.Any) -> t.Any:
+                subprocess.Popen = orig_popen
+                for k, v in extra_kwargs.items():
+                    kwargs.setdefault(k, v)
+                return orig_popen(*args, **kwargs)
+
+            subprocess.Popen = Popen_priority_wrapper  # type: ignore[misc]
 
