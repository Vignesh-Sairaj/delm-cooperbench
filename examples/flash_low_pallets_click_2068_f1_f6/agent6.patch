+            else:
+                nice_values = {
+                    "low": 10,
+                    "below_normal": 5,
+                    "normal": 0,
+                    "above_normal": -5,
+                    "high": -10,
+                }
+                if self.process_priority in nice_values:
+                    nice_val = nice_values[self.process_priority]
+
+                    def _set_priority() -> None:
+                        try:
+                            if hasattr(os, "nice"):
