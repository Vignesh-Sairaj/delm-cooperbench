diff --git a/tests/test_edit_priority.py b/tests/test_edit_priority.py
new file mode 100644
index 0000000..73dfa39
--- /dev/null
+++ b/tests/test_edit_priority.py
@@ -0,0 +1,124 @@
+import subprocess
+import pytest
+import click
+from click._termui_impl import Editor
+
+
+def test_editor_init_process_priority():
+    ed = Editor(process_priority="low")
+    assert ed.process_priority == "low"
+
+    ed_default = Editor()
+    assert ed_default.process_priority is None
+
+
+def test_edit_process_priority_none(monkeypatch):
+    recorded = {}
+
+    def mock_popen(*args, **kwargs):
+        recorded["args"] = args
+        recorded["kwargs"] = kwargs
+
+        class MockProcess:
+            def wait(self):
+                return 0
+
+        return MockProcess()
+
+    monkeypatch.setattr(subprocess, "Popen", mock_popen)
+    click.edit("test text", editor="dummy_editor", process_priority=None)
+
+    assert "creationflags" not in recorded["kwargs"]
+    assert "preexec_fn" not in recorded["kwargs"]
+
+
+def test_edit_process_priority_unix(monkeypatch):
+    recorded = {}
+
+    def mock_popen(*args, **kwargs):
+        recorded["args"] = args
+        recorded["kwargs"] = kwargs
+
+        class MockProcess:
+            def wait(self):
+                return 0
+
+        return MockProcess()
+
+    monkeypatch.setattr(subprocess, "Popen", mock_popen)
+    monkeypatch.setattr("click._termui_impl.WIN", False)
+
+    # Test valid priority
+    click.edit("test text", editor="dummy_editor", process_priority="low")
+    assert "preexec_fn" in recorded["kwargs"]
+    assert callable(recorded["kwargs"]["preexec_fn"])
+
+    # Test preexec_fn executes without error (even if os.nice fails or succeeds)
+    recorded["kwargs"]["preexec_fn"]()
+
+    # Test invalid priority gracefully ignored
+    recorded.clear()
+    click.edit("test text", editor="dummy_editor", process_priority="invalid_priority")
+    assert "preexec_fn" not in recorded.get("kwargs", {})
+
+
+def test_edit_process_priority_windows(monkeypatch):
+    recorded = {}
+
+    def mock_popen(*args, **kwargs):
+        recorded["args"] = args
+        recorded["kwargs"] = kwargs
+
+        class MockProcess:
+            def wait(self):
+                return 0
+
+        return MockProcess()
+
+    monkeypatch.setattr(subprocess, "Popen", mock_popen)
+    monkeypatch.setattr("click._termui_impl.WIN", True)
+
+    for prio, expected_flag in [
+        ("low", 0x00000040),
+        ("below_normal", 0x00004000),
+        ("normal", 0x00000020),
+        ("above_normal", 0x00008000),
+        ("high", 0x00000080),
+    ]:
+        recorded.clear()
+        click.edit("test text", editor="dummy_editor", process_priority=prio)
+        assert recorded["kwargs"].get("creationflags") == expected_flag
+
+    # Invalid priority ignored
+    recorded.clear()
+    click.edit("test text", editor="dummy_editor", process_priority="unknown")
+    assert "creationflags" not in recorded.get("kwargs", {})
+
+
+def test_edit_process_priority_preexec_error_handling(monkeypatch):
+    import os
+
+    def failing_nice(val):
+        raise OSError("Permission denied")
+
+    monkeypatch.setattr(os, "nice", failing_nice, raising=False)
+    monkeypatch.setattr("click._termui_impl.WIN", False)
+
+    recorded = {}
+
+    def mock_popen(*args, **kwargs):
+        recorded["kwargs"] = kwargs
+        if "preexec_fn" in kwargs and kwargs["preexec_fn"]:
+            # Should not raise exception
+            kwargs["preexec_fn"]()
+
+        class MockProcess:
+            def wait(self):
+                return 0
+
+        return MockProcess()
+
+    monkeypatch.setattr(subprocess, "Popen", mock_popen)
+    # Should not raise
+    click.edit("test text", editor="dummy_editor", process_priority="high")
+    assert "preexec_fn" in recorded["kwargs"]
