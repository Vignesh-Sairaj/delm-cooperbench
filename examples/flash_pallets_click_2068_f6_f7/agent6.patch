diff --git a/tests/test_editor_priority.py b/tests/test_editor_priority.py
new file mode 100644
index 0000000..16c6279
--- /dev/null
+++ b/tests/test_editor_priority.py
@@ -0,0 +1,133 @@
+import os
+import sys
+import subprocess
+import pytest
+import click
+from click._termui_impl import Editor
+
+
+def test_editor_init_process_priority():
+    ed = Editor(process_priority="low")
+    assert ed.process_priority == "low"
+
+    ed2 = Editor(process_priority="HIGH")
+    assert ed2.process_priority == "high"
+
+    ed3 = Editor(process_priority=None)
+    assert ed3.process_priority is None
+
+    ed4 = Editor(process_priority="invalid_priority")
+    assert ed4.process_priority is None
+
+
+@pytest.mark.parametrize(
+    "priority",
+    ["low", "below_normal", "normal", "above_normal", "high"],
+)
+def test_editor_valid_priorities(priority):
+    ed = Editor(process_priority=priority)
+    assert ed.process_priority == priority
+
+
+def test_click_edit_process_priority_parameter():
+    # Verify click.edit accepts process_priority without error
+    script = f'{sys.executable} -c "import sys; open(sys.argv[1], \'w\').write(\'test\')"'
+    res = click.edit("input", editor=script, process_priority="low")
+    assert res == "test"
+
+    res_default = click.edit("input", editor=script, process_priority=None)
+    assert res_default == "test"
+
+    res_invalid = click.edit("input", editor=script, process_priority="invalid")
+    assert res_invalid == "test"
+
+
+@pytest.mark.skipif(os.name == "nt", reason="Unix priority check via nice")
+def test_click_edit_priority_low_unix():
+    # Script that writes child nice value
+    script = (
+        f'{sys.executable} -c "import os, sys; '
+        f'open(sys.argv[1], \'w\').write(str(os.getpriority(os.PRIO_PROCESS, 0)))"'
+    )
+    res = click.edit("input", editor=script, process_priority="low")
+    prio = int(res.strip())
+    assert prio > 0  # Lower CPU priority means positive nice value in Unix
+    assert prio == 10
+
+
+@pytest.mark.skipif(os.name == "nt", reason="Unix priority check via nice")
+def test_click_edit_priority_below_normal_unix():
+    script = (
+        f'{sys.executable} -c "import os, sys; '
+        f'open(sys.argv[1], \'w\').write(str(os.getpriority(os.PRIO_PROCESS, 0)))"'
+    )
+    res = click.edit("input", editor=script, process_priority="below_normal")
+    prio = int(res.strip())
+    assert prio > 0
+    assert prio == 5
+
+
+@pytest.mark.skipif(os.name == "nt", reason="Unix priority check via nice")
+def test_click_edit_priority_high_fallback_unix():
+    # In environments where raising priority (negative nice) is disallowed,
+    # it should gracefully fallback and not fail the edit operation
+    script = f'{sys.executable} -c "import sys; open(sys.argv[1], \'w\').write(\'ok\')"'
+    res = click.edit("input", editor=script, process_priority="high")
+    assert res == "ok"
+
+
+def test_click_edit_priority_file_mode(tmp_path):
+    target_file = tmp_path / "test.txt"
+    target_file.write_text("hello")
+
+    script = f'{sys.executable} -c "import sys; open(sys.argv[1], \'a\').write(\' world\')"'
+    res = click.edit(filename=str(target_file), editor=script, process_priority="low")
+    assert res is None
+    assert target_file.read_text() == "hello world"
+
+
+def test_click_edit_windows_priority_flags(monkeypatch):
+    captured_kwargs = {}
+
+    class MockPopen:
+        def __init__(self, cmd, **kwargs):
+            captured_kwargs.update(kwargs)
+
+        def wait(self):
+            return 0
+
+    monkeypatch.setattr(click._termui_impl, "WIN", True)
+    monkeypatch.setattr(subprocess, "Popen", MockPopen)
+
+    for prio, expected_flag in [
+        ("low", 0x40),
+        ("below_normal", 0x4000),
+        ("normal", 0x20),
+        ("above_normal", 0x8000),
+        ("high", 0x80),
+    ]:
+        captured_kwargs.clear()
+        ed = Editor(editor="test_editor", process_priority=prio)
+        ed.edit_file("dummy.txt")
+        assert captured_kwargs.get("creationflags") == expected_flag
+
+
+def test_priority_failure_does_not_fail_edit(monkeypatch):
+    # If Popen with priority flags raises an exception, it should retry without priority
+    calls = []
+
+    orig_popen = subprocess.Popen
+
+    def mock_popen(cmd, **kwargs):
+        calls.append(kwargs)
+        if "preexec_fn" in kwargs or "creationflags" in kwargs:
+            raise OSError("Priority setting not supported")
+        return orig_popen(cmd, **kwargs)
+
+    monkeypatch.setattr(subprocess, "Popen", mock_popen)
+
+    script = f'{sys.executable} -c "import sys; open(sys.argv[1], \'w\').write(\'recovered\')"'
+    res = click.edit("input", editor=script, process_priority="low")
+    assert res == "recovered"
+    # Should have attempted with priority first, then succeeded without
+    assert len(calls) == 2
