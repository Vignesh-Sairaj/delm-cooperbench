+def test_edit_escape_shell_disabled(monkeypatch):
+    called_cmd = []
+
+    class DummyPopen:
+        def __init__(self, cmd, **kwargs):
+            called_cmd.append(cmd)
+
+        def wait(self):
+            return 0
+
+    monkeypatch.setattr("subprocess.Popen", DummyPopen)
+
+    click.edit(filename="file.txt; rm -rf /", editor="vim", escape_shell=False)
+    assert called_cmd == ['vim "file.txt; rm -rf /"']
+
+    called_cmd.clear()
+    click.edit(filename="file.txt; rm -rf /", editor="vim")
+    assert called_cmd == ['vim "file.txt; rm -rf /"']
+
+
+@pytest.mark.parametrize(
+    "filename",
+    [
+        "file.txt; rm -rf /",
+        "file.txt | cat",
+        "file.txt`whoami`",
+        "file.txt$(whoami)",
+        "file name with spaces.txt",
+        'file"name.txt',
+        "file'name.txt",
+    ],
+)
+def test_edit_escape_shell_filename(monkeypatch, filename):
+    import shlex
+
+    called_cmd = []
+
+    class DummyPopen:
+        def __init__(self, cmd, **kwargs):
+            called_cmd.append(cmd)
+
+        def wait(self):
+            return 0
+
+    monkeypatch.setattr("subprocess.Popen", DummyPopen)
+
+    click.edit(filename=filename, editor="vim", escape_shell=True)
+    expected_cmd = f"vim {shlex.quote(filename)}"
+    assert called_cmd == [expected_cmd]
+
+
+@pytest.mark.parametrize(
+    ("editor", "expected_editor_cmd"),
+    [
+        ("vim", "vim"),
+        ("vim -u NONE", "vim -u NONE"),
+        ("sed -i~ 's/$/Test/'", "sed '-i~' 's/$/Test/'"),
+        ("vim; rm -rf /", "'vim;' rm -rf /"),
+        ("vim | malicious", "vim '|' malicious"),
+        ("vim `whoami`", "vim '`whoami`'"),
+        ("vim $(whoami)", "vim '$(whoami)'"),
+    ],
+)
+def test_edit_escape_shell_editor(monkeypatch, editor, expected_editor_cmd):
+    called_cmd = []
+
+    class DummyPopen:
+        def __init__(self, cmd, **kwargs):
+            called_cmd.append(cmd)
+
+        def wait(self):
+            return 0
+
+    monkeypatch.setattr("subprocess.Popen", DummyPopen)
+
+    click.edit(filename="safe.txt", editor=editor, escape_shell=True)
+    assert called_cmd == [f"{expected_editor_cmd} safe.txt"]
+
+
+@pytest.mark.skipif(platform.system() == "Windows", reason="No sed on Windows.")
+def test_edit_escape_shell_functional(runner):
+    result = click.edit("a\nb", editor="sed -i~ 's/$/Test/'", escape_shell=True)
+    assert result == "aTest\nbTest\n"
+
+
+def test_editor_class_escape_shell(monkeypatch):
+    import shlex
+    from click._termui_impl import Editor
+
+    called_cmd = []
+
+    class DummyPopen:
+        def __init__(self, cmd, **kwargs):
+            called_cmd.append(cmd)
+
+        def wait(self):
+            return 0
+
+    monkeypatch.setattr("subprocess.Popen", DummyPopen)
+
+    ed_safe = Editor(editor="vim", escape_shell=True)
+    assert ed_safe.escape_shell is True
+    ed_safe.edit_file("my;file.txt")
+    assert called_cmd == [f"vim {shlex.quote('my;file.txt')}"]
+
+    called_cmd.clear()
+    ed_default = Editor(editor="vim")
+    assert ed_default.escape_shell is False
+    ed_default.edit_file("my;file.txt")
+    assert called_cmd == ['vim "my;file.txt"']
+
