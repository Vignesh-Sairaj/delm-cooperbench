--- /dev/null
+++ b/tests/backends/test_xgrammar_memory.py
@@ -0,0 +1,155 @@
+import pytest
+from unittest.mock import patch, MagicMock
+import transformers
+from outlines.backends.xgrammar import XGrammarLogitsProcessor, XGrammarBackend
+import outlines
+
+
+@pytest.fixture
+def model_transformers():
+    return outlines.from_transformers(
+        transformers.AutoModelForCausalLM.from_pretrained("erwanf/gpt2-mini"),
+        transformers.AutoTokenizer.from_pretrained("erwanf/gpt2-mini"),
+    )
+
+@pytest.fixture
+def json_schema():
+    return (
+        '{"type": "object", "properties": {"name": {"type": "string"}, '
+        + '"age": {"type": "integer"}}, "required": ["name", "age"], '
+        + '"additionalProperties": false}'
+    )
+
+@pytest.fixture
+def regex():
+    return r"[0-9]{3}"
+
+@pytest.fixture
+def cfg():
+    return """
+root ::= answer
+answer ::= "yes" | "no"
+"""
+
+
+def test_memory_tracking_init_default():
+    proc = XGrammarLogitsProcessor("grammar")
+    assert proc.track_memory_usage is False
+    stats = proc.get_memory_stats()
+    assert stats == {
+        "peak_memory_mb": 0.0,
+        "total_calls": 0,
+        "avg_memory_per_call_mb": 0.0,
+        "memory_history": [],
+    }
+
+
+def test_memory_tracking_init_enabled():
+    proc = XGrammarLogitsProcessor("grammar", track_memory_usage=True)
+    assert proc.track_memory_usage is True
+    stats = proc.get_memory_stats()
+    assert stats["total_calls"] == 0
+    assert stats["peak_memory_mb"] == 0.0
+    assert stats["avg_memory_per_call_mb"] == 0.0
+    assert stats["memory_history"] == []
+
+
+def test_process_logits_memory_tracking_disabled():
+    proc = XGrammarLogitsProcessor("grammar", track_memory_usage=False)
+    proc.xgrammar_logits_processor = MagicMock(return_value="output")
+    res = proc.process_logits(None, None)
+    assert res == "output"
+    stats = proc.get_memory_stats()
+    assert stats["total_calls"] == 0
+    assert stats["memory_history"] == []
+
+
+def test_process_logits_memory_tracking_enabled():
+    proc = XGrammarLogitsProcessor("grammar", track_memory_usage=True)
+    proc.xgrammar_logits_processor = MagicMock(return_value="output")
+
+    # Mock _get_memory_usage to return predictable values
+    memory_values = [10.0, 15.0, 20.0, 25.0]
+    with patch.object(proc, "_get_memory_usage", side_effect=memory_values):
+        # Call 1: before takes 10.0, after takes 15.0
+        proc.process_logits(None, None)
+        # Call 2: before takes 20.0, after takes 25.0
+        proc.process_logits(None, None)
+
+    stats = proc.get_memory_stats()
+    assert stats["total_calls"] == 2
+    assert stats["peak_memory_mb"] == 25.0
+    assert stats["avg_memory_per_call_mb"] == (15.0 + 25.0) / 2
+    assert stats["memory_history"] == [15.0, 25.0]
+
+
+def test_memory_tracking_reset():
+    proc = XGrammarLogitsProcessor("grammar", track_memory_usage=True)
+    proc.xgrammar_logits_processor = MagicMock(return_value="output")
+
+    with patch.object(proc, "_get_memory_usage", side_effect=[10.0, 20.0]):
+        proc.process_logits(None, None)
+
+    stats = proc.get_memory_stats()
+    assert stats["total_calls"] == 1
+    assert stats["peak_memory_mb"] == 20.0
+
+    proc.reset()
+    assert proc.xgrammar_logits_processor is None
+    stats_after_reset = proc.get_memory_stats()
+    assert stats_after_reset == {
+        "peak_memory_mb": 0.0,
+        "total_calls": 0,
+        "avg_memory_per_call_mb": 0.0,
+        "memory_history": [],
+    }
+
+
+def test_memory_tracking_graceful_error_handling():
+    proc = XGrammarLogitsProcessor("grammar", track_memory_usage=True)
+    with patch("psutil.Process", side_effect=Exception("psutil error")):
+        mem = proc._get_memory_usage()
+        assert mem == 0.0
+
+
+def test_memory_tracking_logging_every_10_calls(caplog):
+    import logging
+
+    proc = XGrammarLogitsProcessor("grammar", track_memory_usage=True)
+    proc.xgrammar_logits_processor = MagicMock(return_value="output")
+
+    with caplog.at_level(logging.INFO), patch.object(proc, "_get_memory_usage", return_value=50.0):
+        for _ in range(9):
+            proc.process_logits(None, None)
+        assert "Memory stats after 10 calls" not in caplog.text
+
+        proc.process_logits(None, None)
+        assert "Memory stats after 10 calls" in caplog.text
+
+
+def test_backend_methods_accept_track_memory_usage(model_transformers, json_schema, regex, cfg):
+    backend = XGrammarBackend(model_transformers)
+
+    # JSON schema
+    p_json = backend.get_json_schema_logits_processor(json_schema, track_memory_usage=True)
+    assert isinstance(p_json, XGrammarLogitsProcessor)
+    assert p_json.track_memory_usage is True
+
+    # Regex
+    p_regex = backend.get_regex_logits_processor(regex, track_memory_usage=True)
+    assert isinstance(p_regex, XGrammarLogitsProcessor)
+    assert p_regex.track_memory_usage is True
+
+    # CFG
+    p_cfg = backend.get_cfg_logits_processor(cfg, track_memory_usage=True)
+    assert isinstance(p_cfg, XGrammarLogitsProcessor)
+    assert p_cfg.track_memory_usage is True
+
+    # Test generation with tracking
+    generator = outlines.Generator(model_transformers, backend="xgrammar", processor=p_regex)
+    response = generator("Hello, how are you?")
+    assert len(response) == 3
+    stats = p_regex.get_memory_stats()
+    assert stats["total_calls"] > 0
+    assert stats["peak_memory_mb"] > 0.0
+    assert len(stats["memory_history"]) == stats["total_calls"]
