@@ -0,0 +1,120 @@
+import pytest
+import outlines
+from outlines.backends.xgrammar import XGrammarBackend, XGrammarLogitsProcessor
+from outlines.processors.tensor_adapters.torch import TorchTensorAdapter
+from outlines.processors.tensor_adapters import TensorAdapter
+
+
+class CustomTorchAdapter(TorchTensorAdapter):
+    def __init__(self):
+        super().__init__()
+        self.shape_calls = 0
+
+    def shape(self, tensor):
+        self.shape_calls += 1
+        return super().shape(tensor)
+
+
+def test_custom_tensor_adapter_export():
+    from outlines.processors.tensor_adapters import TensorAdapter
+    assert isinstance(TensorAdapter, type)
+
+
+def test_base_logits_processor_custom():
+    from outlines.processors.base_logits_processor import OutlinesLogitsProcessor
+
+    adapter = CustomTorchAdapter()
+
+    # Valid
+    proc = OutlinesLogitsProcessor("custom", custom_adapter=adapter)
+    assert proc.tensor_adapter is adapter
+
+    # Missing adapter
+    with pytest.raises(
+        ValueError,
+        match="custom_adapter must be provided when tensor_library_name is 'custom'",
+    ):
+        OutlinesLogitsProcessor("custom")
+
+    # Provided adapter with non-custom library
+    with pytest.raises(
+        ValueError,
+        match="custom_adapter should only be provided when tensor_library_name is 'custom'",
+    ):
+        OutlinesLogitsProcessor("torch", custom_adapter=adapter)
+
+
+def test_xgrammar_logits_processor_custom():
+    adapter = CustomTorchAdapter()
+    compiled_grammar = "dummy_grammar"
+
+    # Valid
+    proc = XGrammarLogitsProcessor(
+        compiled_grammar,
+        tensor_library_name="custom",
+        custom_adapter=adapter,
+    )
+    assert proc.tensor_adapter is adapter
+
+    # Missing adapter
+    with pytest.raises(
+        ValueError,
+        match="custom_adapter must be provided when tensor_library_name is 'custom'",
+    ):
+        XGrammarLogitsProcessor(compiled_grammar, tensor_library_name="custom")
+
+    # Provided adapter with non-custom library
+    with pytest.raises(
+        ValueError,
+        match="custom_adapter should only be provided when tensor_library_name is 'custom'",
+    ):
+        XGrammarLogitsProcessor(
+            compiled_grammar,
+            tensor_library_name="torch",
+            custom_adapter=adapter,
+        )
+
+
+def test_xgrammar_backend_custom():
+    import transformers
+
+    model = outlines.from_transformers(
+        transformers.AutoModelForCausalLM.from_pretrained("erwanf/gpt2-mini"),
+        transformers.AutoTokenizer.from_pretrained("erwanf/gpt2-mini"),
+    )
+    backend = XGrammarBackend(model)
+    adapter = CustomTorchAdapter()
+
+    # JSON schema
+    json_schema = '{"type": "object", "properties": {"name": {"type": "string"}}}'
+    proc_json = backend.get_json_schema_logits_processor(
+        json_schema,
+        tensor_library_name="custom",
+        custom_adapter=adapter,
+    )
+    assert proc_json.tensor_adapter is adapter
+
+    # Regex
+    regex = r"[0-9]{3}"
+    proc_regex = backend.get_regex_logits_processor(
+        regex,
+        tensor_library_name="custom",
+        custom_adapter=adapter,
+    )
+    assert proc_regex.tensor_adapter is adapter
+
+    # CFG
+    cfg = 'root ::= "yes" | "no"'
+    proc_cfg = backend.get_cfg_logits_processor(
+        cfg,
+        tensor_library_name="custom",
+        custom_adapter=adapter,
+    )
+    assert proc_cfg.tensor_adapter is adapter
+
+    # Test generation with custom adapter
+    generator = outlines.Generator(model, backend="xgrammar", processor=proc_regex)
+    res = generator("Hello")
+    assert len(res) == 3
+    assert int(res)
+    assert adapter.shape_calls > 0
