+    pub fn first(
+        &self,
+        /// Number of characters to return as an array. If omitted, returns a single string.
+        #[named]
+        count: Option<usize>,
+        /// A set of characters to strip from the start of the string before
+        /// extracting the first grapheme cluster.
+        #[named]
+        strip: Option<Str>,
+    ) -> StrResult<Value> {
+        let mut s = self.0.as_str();
+        if let Some(strip) = &strip {
+            s = s.trim_start_matches(|c| strip.0.contains(c));
+        }
+        let mut graphemes = s.graphemes(true);
+        if let Some(count) = count {
+            if count == 0 {
+                bail!("count must be at least 1");
+            }
+            let mut array = Array::new();
+            for _ in 0..count {
+                array.push(
+                    graphemes
+                        .next()
+                        .ok_or_else(|| {
+                            let total = s.graphemes(true).count();
+                            eco_format!(
+                                "not enough characters (requested {}, but string only has {})",
+                                count, total
+                            )
+                        })?
+                        .into_value(),
+                );
+            }
+            Ok(Value::Array(array))
+        } else {
+            graphemes
+                .next()
